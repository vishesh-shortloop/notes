{
  "title": "Notes API",
  "uid": "notes-api",
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "panels": [
    { "type": "timeseries", "title": "Requests / s by status", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (status) (rate(http_requests_total{service=\"notes-api\"}[1m]))", "legendFormat": "{{status}}" }] },
    { "type": "stat", "title": "Success rate (SLO 99%)", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2 } },
      "targets": [{ "expr": "1 - (sum(rate(http_requests_total{service=\"notes-api\",status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_requests_total{service=\"notes-api\"}[5m]))" }] },
    { "type": "stat", "title": "Pods up", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "targets": [{ "expr": "sum(up{service=\"notes-api\"})" }] },
    { "type": "timeseries", "title": "p95 latency (SLO 300ms)", "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket{service=\"notes-api\"}[5m])))", "legendFormat": "{{path}}" }] }
  ]
}
